# Keep this file as a template. Store real keys only in ignored .env.
GOOGLE_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_DEEP_MODEL=gemini-3.8-flash
MAX_CONCURRENT_ANALYSES=2
# Adaptive maximum across all projects (1-20); starts at 6 and backs off on throttling.
SHAPE_INDEX_CONCURRENCY=20
COMPOSITION_INDEX_CONCURRENCY=20
MAX_FILE_SIZE_MB=2000
# DATABASE_PATH=/absolute/path/to/library.sqlite3
# UPLOAD_DIR=/absolute/path/to/media
